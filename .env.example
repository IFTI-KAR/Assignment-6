# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Public base URL of this API (used to build Stripe & Google redirect URLs)
APP_URL=http://localhost:5000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Database (PostgreSQL — Neon / Supabase / local) ----------
DATABASE_URL="postgresql://user:password@localhost:5432/ambulance_dispatch?schema=public"

# ---------- Redis (optional — caching is skipped if empty) ----------
REDIS_URL=""

# ---------- JWT ----------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------- Google OAuth (GCP Console → APIs & Services → Credentials) ----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must be registered as an "Authorized redirect URI" in GCP
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# ---------- Stripe (test mode keys) ----------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=bdt

# ---------- Cloudinary (optional — avatar uploads) ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- Seed ----------
SEED_ADMIN_EMAIL=admin@rescue.com
SEED_ADMIN_PASSWORD=Admin@12345
